# ---------------- APItracker backend (API; also serves the dashboard when SERVE_FRONTEND=true) ----------------
TRACKER_PORT=4310
# 127.0.0.1 = reachable only on this machine (the frontend server, or nginx on a server).
# 0.0.0.0 only when browsers must reach this port directly.
TRACKER_HOST=127.0.0.1
# Web app addresses allowed to call this API straight from the browser (comma separated).
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
# Also serve the dashboard (../frontend/src) at /, so a server needs only this process.
SERVE_FRONTEND=true
CHECK_INTERVAL_MINUTES=30
# Extra URLs to watch (comma separated): uptime, latency, TLS certificate expiry.
# PRATHAM_AI_URL below is watched automatically.
TRACK_URLS=https://appapi.mrpscan.com/api/v1/health
# Email updates over the backend's SMTP account (SMTP_* below or in WATCH_ENV_FILE):
# an email when an issue opens, gets worse or is resolved, plus a daily summary.
# Comma-separated recipients; empty = off.
ALERT_EMAIL_TO=
# IST hour for the daily summary (0-23), or "off".
DAILY_SUMMARY_HOUR=9
# Link put in the emails.
DASHBOARD_URL=https://apitracker.mrpscan.com
# Optional: read the watched keys from another .env (e.g. the backend's) instead of this file.
# It is re-read before every check, so a rotated key shows up without a restart.
# WATCH_ENV_FILE=../../backend/.env

# ---------------- Watched keys (MRPscan backend .env) ----------------
REDIS_URL=
USE_MEMORY_STORE=false
MONGODB_URI=


PORT=3000
NODE_ENV=production

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


## Invoice email (Titan SMTP), same values as the MRPscan backend
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

## OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

## MCX
METALS_API_KEY=
BILLING_TIMEZONE=Asia/Kolkata
MCX_SCHEDULER_TIMEZONE=Asia/Kolkata
MCX_TRADING_DAYS=1,2,3,4,5
MCX_TRADING_START_TIME=09:00:00
MCX_TRADING_END_TIME=23:55:00
MCX_POLL_INTERVAL_SECONDS=140

## PDFMonkey
PDFMONKEY_API_SECRET=
PDFMONKEY_TEMPLATE_ID_FOR_PREVIEW_INVOICE=
PDFMONKEY_TEMPLATE_ID_FOR_E_INVOICE=

## Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


## GSTIN verification
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
GST_VERIFY_MODE=live

## OpenAI
OPENAI_API_KEY=
# Optional Admin key (platform.openai.com → Settings → Admin keys): lets the tracker read
# real spend and count down a balance entered in "Balance & expiry". Read-only use.
OPENAI_ADMIN_KEY=
OPENAI_SERVICE_TIER=priority
DEBUG_AI_LOGS=true
OPENAI_REASONING_EFFORT=low
OCR_MULTI_VIEW=true
OCR_DOUBLE_READ=true
OCR_ADJUDICATE=true
OCR_ORIENTATION_FIX=true
MAX_UPLOAD_MB=80
OCR_MAX_EDGE_PX=2400
OCR_JPEG_QUALITY=82


EINVOICE_CRED_KEY=
PRATHAM_AI_URL=https://prathamai.mrpscan.com
