# Copy to .env and adjust. Nothing secret lives here: the API keys stay in backend/.env.

# Port the dashboard (and the phone app) opens.
FRONTEND_PORT=4300
# 0.0.0.0 = reachable from the phone on the same Wi-Fi. 127.0.0.1 = this computer only.
FRONTEND_HOST=0.0.0.0
# Backend address this server forwards /api to (used when API_URL is empty).
BACKEND_URL=http://127.0.0.1:4310
# Backend address the BROWSER calls directly, e.g. https://api.example.com.
# Empty = the browser calls /api on the dashboard's own address and this server forwards it.
# When set, add the dashboard's address to the backend's CORS_ORIGINS.
API_URL=
